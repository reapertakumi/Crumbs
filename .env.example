# Copy this file to .env (next to docker-compose.yml) and fill in what you want.
# Everything is optional.

# The database key. If set, Crumbs unlocks itself whenever the Pi starts.
# If empty, Crumbs shows an Unlock page after each start and an admin types it.
# Keeping it here is convenient, but someone holding the SD card then has it too.
CRUMBS_DB_KEY=

# Extra names / IP addresses you open Crumbs with, for the self-signed HTTPS
# certificate (comma separated). Delete data/tls after changing this.
TLS_HOSTS=raspberrypi.local

# 1 = visitors on http:// are sent to https:// (0 = both work side by side).
HTTP_REDIRECT=0
